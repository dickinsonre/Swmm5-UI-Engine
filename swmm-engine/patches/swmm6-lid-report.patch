+/**
+ * @file LIDReport.hpp
+ * @brief Consolidated detailed LID report (.lid) writer.
+ *
+ * @details Legacy SWMM5 writes one detailed report file per LID unit, named
+ *          by the RptFile token in [LID_USAGE]. That does not survive a
+ *          browser MEMFS round-trip well (the host cannot discover the file
+ *          names generically), so this writer emits a SINGLE file for every
+ *          reporting unit in the project — path = report path with the
+ *          extension replaced by `.lid` — with each row key-prefixed by
+ *          `subcatch \t lid \t unitNo`.
+ *
+ *          Format is byte-compatible with the SWMM5 consolidated writer
+ *          (`;SWMM5 Consolidated LID Report v1`): a [META] block, a
+ *          [CONTROLS] block describing each LID's layer stack so a viewer can
+ *          draw the profile without re-parsing the .inp, and a [RESULTS]
+ *          block of 17 tab-separated columns.
+ *
+ *          The RptFile token keeps its legacy meaning of "report this unit";
+ *          the file name it carries is ignored, and `*` means no reporting.
+ *
+ *          Dry-period compression matches legacy lidproc_saveResults(): while
+ *          a unit is dry only the first and last row of the dry spell are
+ *          emitted, so rows have TIME GAPS. Anything integrating a rate over
+ *          rows must skip intervals much larger than the report step.
+ *
+ * @note Legacy reference: src/legacy/engine/lid.c, lidproc.c
+ * @ingroup new_engine
+ */
+
+#ifndef OPENSWMM_LIDREPORT_HPP
+#define OPENSWMM_LIDREPORT_HPP
+
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace openswmm {
+
+struct SimulationContext;
+
+namespace lid {
+
+class LIDSolver;
+
+/**
+ * @brief Writes the consolidated `.lid` detailed report.
+ *
+ * Lifecycle: open() once after LIDSolver::init(), writeStep() on each report
+ * boundary, close() at end of run. All three are no-ops when no LID unit in
+ * the project requested detailed reporting.
+ */
+class LIDReport {
+public:
+    LIDReport() = default;
+    ~LIDReport();
+
+    LIDReport(const LIDReport&) = delete;
+    LIDReport& operator=(const LIDReport&) = delete;
+
+    /**
+     * @brief Open the report and write the [META]/[CONTROLS]/[RESULTS] headers.
+     *
+     * @param ctx       Simulation context (parsed, after LIDSolver::init()).
+     * @param rpt_path  Report file path; the `.lid` path is derived from it.
+     * @param solver    LID solver, for unit -> (group, slot) resolution.
+     * @return true if the file was opened and at least one unit reports.
+     */
+    bool open(SimulationContext& ctx, const std::string& rpt_path,
+              LIDSolver& solver);
+
+    /**
+     * @brief Emit one row per reporting unit for the current report instant.
+     *
+     * @param ctx          Simulation context.
+     * @param solver       LID solver holding current per-unit state.
+     * @param report_date  Report instant as an OADate.
+     * @param elapsed_hrs  Elapsed hours since start of simulation.
+     */
+    void writeStep(SimulationContext& ctx, LIDSolver& solver,
+                   double report_date, double elapsed_hrs);
+
+    /// Flush and close. Safe to call more than once.
+    void close();
+
+    /// True when a file is open and rows are being written.
+    bool active() const { return file_ != nullptr; }
+
+private:
+    /// One reporting unit: where its state lives, plus its dry-run state.
+    struct UnitRef {
+        int         group = 0;      ///< Index into LIDSolver groups
+        int         slot  = 0;      ///< Index within that group
+        std::string key;            ///< "subcatch\tlid\tunitNo"
+        std::string pending;        ///< Last formatted row, held back while dry
+        int         was_dry = 1;    ///< Consecutive dry periods (legacy semantics)
+    };
+
+    void writeControlsBlock(SimulationContext& ctx);
+
+    std::FILE*           file_ = nullptr;
+    std::vector<UnitRef> units_;
+    double               ucf_rate_  = 43200.0;  ///< ft/sec -> in/hr or mm/hr
+    double               ucf_depth_ = 12.0;     ///< ft -> inches or mm
+};
+
+} // namespace lid
+} // namespace openswmm
+
+#endif // OPENSWMM_LIDREPORT_HPP
