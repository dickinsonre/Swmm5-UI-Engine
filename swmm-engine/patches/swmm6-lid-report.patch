+// limitations under the License.
+
+/**
+ * @file LIDReport.cpp
+ * @brief Consolidated detailed LID report (.lid) writer.
+ * @ingroup new_engine
+ */
+
+#include "LIDReport.hpp"
+
+#include "LID.hpp"
+#include "../core/DateTime.hpp"
+#include "../core/SimulationContext.hpp"
+#include "../core/UnitConversion.hpp"
+
+#include <array>
+#include <cstdio>
+#include <string>
+
+namespace openswmm {
+namespace lid {
+
+namespace {
+
+/// Flow cutoff for dry conditions (= 0.001 in/hr). Legacy lidproc.c MINFLOW.
+constexpr double MINFLOW = 2.3e-8;
+
+/// LID type code -> group index. Must stay in lockstep with the private
+/// typeCodeToIndex() in LID.cpp, or rows land on the wrong unit.
+int typeCodeToGroup(const std::string& code) {
+    if (code == "BC") return 0;
+    if (code == "RG") return 1;
+    if (code == "GR") return 2;
+    if (code == "IT") return 3;
+    if (code == "PP") return 4;
+    if (code == "RB") return 5;
+    if (code == "VS") return 6;
+    if (code == "RD") return 7;
+    return -1;
+}
+
+/// Legacy RptFile semantics: a unit reports unless the token is absent or `*`.
+bool unitReports(const std::string& token) {
+    if (token.empty()) return false;
+    if (token == "*") return false;
+    return true;
+}
+
+} // namespace
+
+LIDReport::~LIDReport() {
+    close();
+}
+
+//=============================================================================
+
+bool LIDReport::open(SimulationContext& ctx, const std::string& rpt_path,
+                     LIDSolver& solver) {
+    close();
+    if (rpt_path.empty()) return false;
+
+    const int n_usage = ctx.lid_usage.count();
+    if (n_usage == 0) return false;
+
+    // Resolve every reporting unit to its (group, slot) home. This walks the
+    // usage rows in exactly the order LIDSolver::init() does, with the same
+    // skip conditions, so the cursors land on the same slots. Any divergence
+    // here silently reports one unit's state under another unit's name.
+    std::array<int, 8> type_cursor = {};
+    for (int j = 0; j < n_usage; ++j) {
+        auto uj = static_cast<std::size_t>(j);
+        int li = ctx.lid_usage.lid_index[uj];
+        if (li < 0 || li >= ctx.lid_controls.count()) continue;
+        auto uli = static_cast<std::size_t>(li);
+        int ti = typeCodeToGroup(ctx.lid_controls.lid_type[uli]);
+        if (ti < 0 || ti >= 8) continue;
+
+        int slot = type_cursor[static_cast<std::size_t>(ti)]++;
+
+        const std::string& rpt_token =
+            (uj < ctx.lid_usage.rpt_file.size()) ? ctx.lid_usage.rpt_file[uj]
+                                                 : std::string();
+        if (!unitReports(rpt_token)) continue;
+
+        int sc = ctx.lid_usage.subcatch_index[uj];
+        if (sc < 0 || sc >= ctx.n_subcatches()) continue;
+
+        const std::string& subcatch_id = ctx.subcatch_names.name_of(sc);
+        const std::string& lid_id      = ctx.lid_controls.names[uli];
+
+        // Unit number is per (subcatch, LID) pair, in usage order — matching
+        // the legacy consolidated writer's nextLidUnitNumber().
+        int unit_no = 1;
+        for (const auto& prior : units_) {
+            if (prior.key.rfind(subcatch_id + "\t" + lid_id + "\t", 0) == 0)
+                ++unit_no;
+        }
+
+        UnitRef ref;
+        ref.group   = ti;
+        ref.slot    = slot;
+        ref.key     = subcatch_id + "\t" + lid_id + "\t" + std::to_string(unit_no);
+        ref.was_dry = 1;
+        units_.push_back(std::move(ref));
+    }
+
+    if (units_.empty()) return false;
+
+    // Path = report path with its extension replaced by .lid (only strip a dot
+    // that belongs to the file name, not to a directory component).
+    std::string path = rpt_path;
+    const std::size_t dot = path.find_last_of('.');
+    const std::size_t sep = path.find_last_of("/\\");
+    if (dot != std::string::npos && (sep == std::string::npos || dot > sep))
+        path.erase(dot);
+    path += ".lid";
+
+    file_ = std::fopen(path.c_str(), "wt");
+    if (file_ == nullptr) {
+        units_.clear();
+        return false;
+    }
+
+    const int us = ucf::getUnitSystem(static_cast<int>(ctx.options.flow_units));
+    const auto uus = static_cast<std::size_t>(us);
+    ucf_rate_  = ucf::Ucf[ucf::RAINFALL][uus];
+    ucf_depth_ = ucf::Ucf[ucf::RAINDEPTH][uus];
+
+    const int report_step = static_cast<int>(ctx.options.report_step);
+    const int hr  = report_step / 3600;
+    const int min = (report_step % 3600) / 60;
+    const int sec = report_step % 60;
+
+    const std::string title =
+        ctx.title_notes.empty() ? std::string() : ctx.title_notes.front();
+    const int fu = static_cast<int>(ctx.options.flow_units);
+
+    std::fprintf(file_, ";SWMM6 Consolidated LID Report v1");
+    std::fprintf(file_, "\n[META]");
+    std::fprintf(file_, "\nProject\t%s", title.c_str());
+    std::fprintf(file_, "\nEngine\t6.0.0-alpha.3-lid1");
+    std::fprintf(file_, "\nFlowUnits\t%s", ucf::FlowUnitWords[fu]);
+    std::fprintf(file_, "\nReportStep\t%02d:%02d:%02d", hr, min, sec);
+    if (us == 0)
+        std::fprintf(file_, "\nUnits\trates=in/hr depths=inches moisture=fraction");
+    else
+        std::fprintf(file_, "\nUnits\trates=mm/hr depths=mm moisture=fraction");
+
+    writeControlsBlock(ctx);
+
+    std::fprintf(file_, "\n\n[RESULTS]");
+    std::fprintf(file_, "\n;Subcatch\tLID\tUnit\tDate       Time    \tElapsedHours\t"
+        "TotalInflow\tTotalEvap\tSurfInfil\tPavePerc\tSoilPerc\tStorExfil\t"
+        "SurfRunoff\tDrainOutflow\tSurfLevel\tPaveLevel\tSoilMoisture\tStorLevel");
+
+    (void)solver;
+    return true;
+}
+
+//=============================================================================
+
+void LIDReport::writeControlsBlock(SimulationContext& ctx) {
+    // LidControlStore holds the [LID_CONTROLS] values verbatim in project
+    // units — the same units this block advertises — so nothing is converted
+    // here. (The SoA the results block reads from IS internal; that one is
+    // converted. Do not "unify" the two.)
+    const bool us_units = (ucf_depth_ == 12.0);
+
+    std::fprintf(file_, "\n[CONTROLS]");
+    std::fprintf(file_, "\n;LID\tType|Layer\tParameters (depths in %s, rates in %s)",
+        us_units ? "inches" : "mm", us_units ? "in/hr" : "mm/hr");
+
+    const int n = ctx.lid_controls.count();
+    for (int j = 0; j < n; ++j) {
+        auto uj = static_cast<std::size_t>(j);
+        const std::string& id = ctx.lid_controls.names[uj];
+        std::fprintf(file_, "\n%s\t%s", id.c_str(),
+                     ctx.lid_controls.lid_type[uj].c_str());
+
+        if (uj < ctx.lid_controls.surface.size()) {
+            const auto& p = ctx.lid_controls.surface[uj];
+            if (p[0] > 0.0 || p[2] > 0.0)
+                std::fprintf(file_, "\n%s\tSURFACE\t%.4f\t%.4f\t%.4f\t%.4f",
+                    id.c_str(), p[0], p[1], p[2], p[3]);
+        }
+        if (uj < ctx.lid_controls.pavement.size()) {
+            const auto& p = ctx.lid_controls.pavement[uj];
+            if (p[0] > 0.0)
+                std::fprintf(file_, "\n%s\tPAVEMENT\t%.4f\t%.4f\t%.4f\t%.4f\t%.4f",
+                    id.c_str(), p[0], p[1], p[2], p[3], p[4]);
+        }
+        if (uj < ctx.lid_controls.soil.size()) {
+            const auto& p = ctx.lid_controls.soil[uj];
+            if (p[0] > 0.0)
+                std::fprintf(file_, "\n%s\tSOIL\t%.4f\t%.4f\t%.4f\t%.4f\t%.4f\t%.4f\t%.4f",
+                    id.c_str(), p[0], p[1], p[2], p[3], p[4], p[5], p[6]);
+        }
+        if (uj < ctx.lid_controls.storage.size()) {
+            const auto& p = ctx.lid_controls.storage[uj];
+            if (p[0] > 0.0)
+                std::fprintf(file_, "\n%s\tSTORAGE\t%.4f\t%.4f\t%.4f\t%.4f",
+                    id.c_str(), p[0], p[1], p[2], p[3]);
+        }
+        if (uj < ctx.lid_controls.drain.size()) {
+            const auto& p = ctx.lid_controls.drain[uj];
+            if (p[0] > 0.0)
+                std::fprintf(file_, "\n%s\tDRAIN\t%.4f\t%.4f\t%.4f\t%.4f\t%.4f\t%.4f",
+                    id.c_str(), p[0], p[1], p[2], p[3], p[4], p[5]);
+        }
+        if (uj < ctx.lid_controls.drainmat.size()) {
+            const auto& p = ctx.lid_controls.drainmat[uj];
+            if (p[0] > 0.0)
+                std::fprintf(file_, "\n%s\tDRAINMAT\t%.4f\t%.4f\t%.4f",
+                    id.c_str(), p[0], p[1], p[2]);
+        }
+    }
+}
+
+//=============================================================================
+
+void LIDReport::writeStep(SimulationContext& ctx, LIDSolver& solver,
+                          double report_date, double elapsed_hrs) {
+    if (file_ == nullptr) return;
+    (void)ctx;
+
+    int year = 0, month = 0, day = 0, hour = 0, minute = 0, second = 0;
+    datetime::decodeDate(report_date, year, month, day);
+    datetime::decodeTime(report_date, hour, minute, second);
+
+    char stamp[32];
+    std::snprintf(stamp, sizeof(stamp), "%02d/%02d/%04d %02d:%02d:%02d",
+                  month, day, year, hour, minute, second);
+
+    for (auto& u : units_) {
+        const LIDGroupSoA& g = solver.group(u.group);
+        if (u.slot < 0 || u.slot >= g.count) continue;
+        const auto ui = static_cast<std::size_t>(u.slot);
+
+        // Rates -> in/hr (or mm/hr); depths -> inches (or mm); moisture stays
+        // a fraction. Same 12 columns, same order, as the legacy writer.
+        const double inflow    = g.rpt_inflow[ui]     * ucf_rate_;
+        const double evap      = g.rpt_evap[ui]       * ucf_rate_;
+        const double surfInfil = g.rpt_surf_infil[ui] * ucf_rate_;
+        const double pavePerc  = g.rpt_pave_perc[ui]  * ucf_rate_;
+        const double soilPerc  = g.rpt_soil_perc[ui]  * ucf_rate_;
+        const double storExfil = g.rpt_stor_exfil[ui] * ucf_rate_;
+        const double runoff    = g.surface_runoff[ui] * ucf_rate_;
+        const double drain     = g.drain_flow[ui]     * ucf_rate_;
+        const double surfLevel = g.surf_depth[ui]     * ucf_depth_;
+        const double paveLevel = g.pave_depth[ui]     * ucf_depth_;
+        const double soilMoist = g.soil_moist[ui];
+        const double storLevel = g.stor_depth[ui]     * ucf_depth_;
+
+        // Dry test on the INTERNAL rates, exactly as legacy does before any
+        // unit conversion (MINFLOW is a ft/sec threshold).
+        const bool is_dry = g.rpt_inflow[ui]     < MINFLOW &&
+                            g.surface_runoff[ui] < MINFLOW &&
+                            g.drain_flow[ui]     < MINFLOW &&
+                            g.rpt_stor_exfil[ui] < MINFLOW &&
+                            g.rpt_evap[ui]       < MINFLOW;
+
+        // Wet again after a dry spell longer than one period: flush the last
+        // held row first, so the dry spell is bracketed by a row at each end.
+        if (!is_dry && u.was_dry > 1 && !u.pending.empty())
+            std::fputs(u.pending.c_str(), file_);
+
+        char row[512];
+        std::snprintf(row, sizeof(row),
+            "\n%s\t%20s\t %8.3f\t %8.3f\t %8.4f\t %8.3f\t %8.3f\t %8.3f\t %8.3f\t"
+            "%8.3f\t %8.3f\t %8.3f\t %8.3f\t %8.3f\t %8.3f",
+            u.key.c_str(), stamp, elapsed_hrs,
+            inflow, evap, surfInfil, pavePerc, soilPerc, storExfil,
+            runoff, drain, surfLevel, paveLevel, soilMoist, storLevel);
+        u.pending.assign(row);
+
+        if (is_dry) {
+            // First dry period after a wet one marks the start of the gap.
+            if (u.was_dry == 0) std::fputs(u.pending.c_str(), file_);
+            ++u.was_dry;
+        } else {
+            std::fputs(u.pending.c_str(), file_);
+            u.was_dry = 0;
+        }
+    }
+}
+
+//=============================================================================
+
+void LIDReport::close() {
+    if (file_ != nullptr) {
+        std::fputs("\n", file_);
+        std::fclose(file_);
+        file_ = nullptr;
+    }
+    units_.clear();
+}
+
+} // namespace lid
+} // namespace openswmm
